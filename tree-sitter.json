{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "just",
      "camelcase": "Just",
      "title": "Sieve",
      "scope": "source.just",
      "path": ".",
      "file-types": null,
      "injection-regex": "^just$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Just grammar for tree-sitter",
    "authors": [
      {
        "name": "Alexis (Poliorcetics) Bourget",
        "url": "https://github.com/poliorcetics"
      }
    ],
    "links": {
      "repository": "https://github.com/poliorcetics/tree-sitter-just"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
